{
  "name": "mailspring-todoist",
  "version": "0.1.0",
  "description": "Create Todoist tasks straight from Mailspring with one click.",
  "main": "./lib/main",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/check-styles.js",
    "watch": "tsc --watch",
    "check:styles": "node scripts/check-styles.js",
    "install-local": "node scripts/install-local.js",
    "pretest": "tsc",
    "test": "node --test \"test/**/*.test.js\"",
    "clean": "rm -rf lib"
  },
  "engines": {
    "mailspring": ">=1.6.3"
  },
  "windowTypes": {
    "default": true
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^16.14.0",
    "less": "^4.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.4.5"
  }
}
